#pragma once
// secrets.h にコピーして 2.4GHz の AP を書く。secrets.h は gitignore 済み。
//
// lt7680_multi (キューブの各モジュール) と espnow_bridge (中継) で、同じ並びにすること。
// 起動時に、スキャンで見えた AP を並び順に試し、最初につながったものを使う。ESP-NOW は、つないだ AP の
// チャンネルに相乗りするので、並びが同じなら、複数の AP が見える場所でも全台が同じ AP、同じチャンネルにそろう。
// 1 つも見えなければ、並びを順に直接試す (隠し SSID)。どれにもつながらなければ ESPNOW_CHANNEL (1) で ESP-NOW だけ使う。
// 自宅と展示 (スマホのテザリングなど) のために、複数書く。expt-the-map-runs と同じ形
#define WIFI_APS { \
    {"your_home_24ghz_ssid", "your_home_password"}, \
    {"your_phone_hotspot",   "your_hotspot_password"}, \
}
